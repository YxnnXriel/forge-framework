{
  "name": "forge-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "bench"
    ],
    "catalog": {
      "zod": "4.6.7",
      "hono": "4.13.13",
      "svelte": "5.57.2",
      "better-auth": "1.7.10",
      "prisma": "7.10.1",
      "@prisma/client": "7.10.1",
      "@prisma/adapter-pg": "7.10.1",
      "typescript": "6.0.3",
      "@types/bun": "1.4.3",
      "devalue": "6.0.3",
      "playwright-core": "1.64.1",
      "svelte-check": "4.7.6",
      "prisma-adapter-bun-sqlite": "0.8.0"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/api-only && tsc --noEmit -p examples/full-stack && tsc --noEmit -p examples/web-only",
    "check:svelte": "bun run --filter 'example-full-stack' --filter 'example-web-only' check",
    "check": "bun run db:generate && bun test && bun run typecheck && bun run check:svelte",
    "example:api": "bun run --filter example-api-only dev",
    "example:full": "bun run --filter example-full-stack dev",
    "example:web": "bun run --filter example-web-only dev",
    "db:generate": "bun run --filter example-full-stack db:generate",
    "bench": "bun run --filter forge-bench bench",
    "build:native": "bun run --filter @forge/rust-engine build"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "svelte-check": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
