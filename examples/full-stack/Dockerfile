# Generated by `forge setup docker` (Dokploy, Railway, any Docker host).
# Build context: the repository root (the project is a workspace member).

# Forge's native engine (Rust), embedded in the executable.
FROM rust:1-slim AS engine
WORKDIR /src
COPY packages/rust-engine/native ./native
RUN cargo build --release --manifest-path native/Cargo.toml

FROM oven/bun:1.4 AS build
WORKDIR /repo
COPY . .
COPY --from=engine /src/native/target/release/libforge_engine.so packages/rust-engine/native/target/release/
RUN bun install --frozen-lockfile
WORKDIR /repo/examples/full-stack
# One self-contained executable: server, pages, assets, migrations.
RUN bun run forge build --compile
RUN mkdir -p /data

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=build /repo/examples/full-stack/.forge/build/server /app/server
# SQLite: mount a persistent volume on /data.
COPY --from=build --chown=nonroot:nonroot /data /data
ENV DATABASE_URL="file:/data/app.db"
VOLUME ["/data"]
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
ENTRYPOINT ["/app/server"]
# Applies pending migrations, then serves.
CMD ["start", "--migrate"]
